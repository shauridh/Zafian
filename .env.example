# ===== Database (Supabase PostgreSQL) =====
# Runtime (via pooler/pgBouncer — WAJIB untuk Vercel/serverless):
# Supabase → Project Settings → Database → Connection string → "Connection pooling"
# Tambahkan ?pgbouncer=true&connection_limit=1 di akhir
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrasi (koneksi langsung, port 5432):
# Supabase → Project Settings → Database → Connection string → "URI"
DIRECT_URL="postgresql://postgres:PASSWORD@db.REF.supabase.co:5432/postgres"

# ===== Auth (NextAuth) =====
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-secret-random-panjang"
# URL publik aplikasi (tanpa trailing slash) — contoh: https://zafian.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ===== Supabase Storage (upload foto produk) =====
# Supabase → Project Settings → API → Project URL & service_role key
# Kosongkan untuk fallback penyimpanan lokal (hanya untuk dev)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="product-images"
